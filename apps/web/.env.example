# Base URL of the Researchly engine (services/engine). Inlined into the
# browser bundle at build time and added to the CSP's connect-src.
NEXT_PUBLIC_ENGINE_URL=http://localhost:8080

# Accounts (S2): sign-in, file uploads, synced settings. Leave BOTH unset for
# the S1 site (paste only, no sign-in UI). Both are public by design: Row-Level
# Security protects the data. The build fails on a malformed value, and on a
# secret key (sb_secret_...) pasted here by mistake.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
