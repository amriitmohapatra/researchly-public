{
  "name": "@researchly/contract",
  "version": "1.0.0",
  "private": true,
  "description": "API contract v1 — TypeScript types generated from the engine's OpenAPI document. Never edit src/schema.d.ts by hand.",
  "types": "src/index.ts",
  "main": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "check": "openapi-typescript openapi.json -o /tmp/researchly-schema-check.d.ts && diff -q src/schema.d.ts /tmp/researchly-schema-check.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
